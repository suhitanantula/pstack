#!/usr/bin/env bash
# pstack setup — register skills with Claude Code
# Usage: ./setup
set -e

PSTACK_DIR="$(cd "$(dirname "$0")" && pwd -P)"
SKILLS_DIR="$HOME/.claude/skills"
BIN_DIR="$HOME/.local/bin"

SKILLS=(
  pstack
  pstack-perceive
  pstack-perform
  pstack-portfolio
  pstack-decide
  pstack-progress
  pstack-observer
  pstack-upgrade
)

mkdir -p "$SKILLS_DIR"
mkdir -p "$BIN_DIR"

echo "Installing pstack skills..."

for skill in "${SKILLS[@]}"; do
  target="$SKILLS_DIR/$skill"
  # Remove old symlink or directory
  [ -L "$target" ] && rm -f "$target"
  [ -d "$target" ] && rm -rf "$target"

  if [ "$skill" = "pstack" ]; then
    # Root skill — symlink the whole repo dir
    ln -snf "$PSTACK_DIR" "$target"
  else
    ln -snf "$PSTACK_DIR/$skill" "$target"
  fi
  echo "  linked: $skill"
done

# Make bin scripts executable
chmod +x "$PSTACK_DIR/bin/"* 2>/dev/null || true

# Install CLI shim onto PATH
rm -f "$BIN_DIR/pstack"
ln -snf "$PSTACK_DIR/bin/pstack" "$BIN_DIR/pstack"

# Create state dir
mkdir -p "$HOME/.pstack"

echo ""
echo "pstack ready. Available skills:"
echo "  /pstack              — 5Ps of Loop Design overview"
echo "  /pstack-perceive     — Perceive: Never Forget the People"
echo "  /pstack-perform      — Perform: Move with Intention"
echo "  /pstack-portfolio    — Portfolio: Designing for Anti-Fragility"
echo "  /pstack-decide       — Pause/Promote: Choose What Matters"
echo "  /pstack-progress     — Progress: Build Learning Systems"
echo "  /pstack-observer     — Observer: Meta-awareness across loops"
echo "  /pstack-upgrade      — Self-updater"
echo ""
echo "CLI:"
echo "  pstack --help        — usage and install diagnostics"
